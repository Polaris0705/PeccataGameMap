rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // KP admin emails live in the Firestore doc config/admins  (field: emails = array of lowercase emails)
    // You never need to edit this file. Edit that doc in the Firebase console instead.

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function myHo() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ho;
    }
    function canChan(ch) {
      return signedIn() && (ch == 'rp' || ch == 'ooc' || isAdmin()
        || (ch.matches('dm_.+') && request.auth.uid in ch.split('_'))
        || (exists(/databases/$(database)/documents/channels/$(ch)) && get(/databases/$(database)/documents/channels/$(ch)).data.type == 'secret'
            && myHo() in get(/databases/$(database)/documents/channels/$(ch)).data.members));
    }
    function notLocked(ch) {
      return isAdmin() || !exists(/databases/$(database)/documents/channels/$(ch)) || get(/databases/$(database)/documents/channels/$(ch)).data.get('locked', false) != true;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }

    match /progress/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }

    match /sched/{id} {
      allow read, write: if isAdmin();
    }

    match /public/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /maps/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /mapchunks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /assets/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && onlyChanges(['status']));
      allow delete: if isAdmin();
    }

    match /queue/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /calls/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
      allow update: if isMe(uid) && onlyChanges(['ack']);
    }

    match /itemDefs/{id} {
      allow read, write: if isAdmin();
    }
    match /recipes/{id} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    match /items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && onlyChanges(['owner', 'ownerName', 'fromName', 'seen', 'inspectReq']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.via is string
        && exists(/databases/$(database)/documents/recipes/$(request.resource.data.via))
        && get(/databases/$(database)/documents/recipes/$(request.resource.data.via)).data.result == request.resource.data.defId
        && request.resource.data.revealed == false;
    }

    match /pushSubs/{uid} {
      allow read, write: if isMe(uid);
    }

    match /channels/{ch} {
      allow get: if canChan(ch);
      allow list, write: if isAdmin();
      match /msgs/{m} {
        allow read: if canChan(ch);
        allow create: if canChan(ch) && notLocked(ch)
          && request.resource.data.uid == request.auth.uid
          && (isAdmin() || (request.resource.data.kind in ['ic', 'ooc']
                            && request.resource.data.code in [myHo(), '']));
        allow update: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid
              && onlyChanges(['text', 'img', 'edited', 'deleted']));
        allow delete: if isAdmin();
      }
    }
    match /chatIndex/{ho} {
      allow read: if isAdmin() || (signedIn() && myHo() == ho);
      allow write: if isAdmin();
    }
    match /pings/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
    }

    match /rooms/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.host == request.auth.uid);
    }

    match /roomSecrets/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if signedIn() && (request.resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/rooms/$(request.resource.data.room)).data.host == request.auth.uid);
    }

    match /draws/{id} {
      allow read, write: if signedIn();
    }

    match /teleBooks/{id} {
      allow read, write: if signedIn();
    }

    match /games/{id} {
      allow read, write: if signedIn();
    }

    match /truths/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if signedIn() && (resource.data.uid == request.auth.uid
        || (resource.data.status == 'open' && onlyChanges(['votes'])));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /truthKeys/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /eggs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /notes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && (request.resource.data.kp == false || isAdmin());
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /roomLikes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.owner + '_' + request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /guestbook/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow delete: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || resource.data.owner == request.auth.uid));
    }
  }
}
