rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ KP(관리자) 이메일 — index.html의 CONFIG.adminEmails와 똑같이 맞춰 주세요 (소문자)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kp1@example.com', 'kp2@example.com'];
    }
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function myHo() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ho;
    }
    function chanPath(ch) { return /databases/$(database)/documents/channels/$(ch); }
    // 채팅 채널 접근: 공개 채널 / KP / 귓속말 당사자 / 비밀 채널 참여 HO
    function canChan(ch) {
      return signedIn() && (ch == 'rp' || ch == 'ooc' || isAdmin()
        || (ch.matches('dm_.+') && request.auth.uid in ch.split('_'))
        || (exists(chanPath(ch)) && get(chanPath(ch)).data.type == 'secret'
            && myHo() in get(chanPath(ch)).data.members));
    }
    function notLocked(ch) {
      return isAdmin() || !exists(chanPath(ch)) || get(chanPath(ch)).data.get('locked', false) != true;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 회원 정보 (이름, HO)
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }

    // 미니게임 진행도 + 개인 메모 (랭킹 때문에 읽기는 공개)
    match /progress/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }

    // KP 스케줄러 원본 (PL은 못 봄)
    match /sched/{id} {
      allow read, write: if isAdmin();
    }

    // PL에게 공개되는 정보 (공개 장소/맵, Day 이름, 빈 슬롯)
    match /public/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /maps/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /mapchunks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /assets/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 조사 예약
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && onlyChanges(['status']));
      allow delete: if isAdmin();
    }

    // 대기열 / 호출
    match /queue/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /calls/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
      allow update: if isMe(uid) && onlyChanges(['ack']);
    }

    // 아이템 정의 (숨은 글 포함 → KP만)
    match /itemDefs/{id} {
      allow read, write: if isAdmin();
    }
    // 조합법: PL은 정확한 조합 문서 하나만 확인 가능 (목록 조회 불가)
    match /recipes/{id} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    // 지급된 물건
    match /items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      // 주인: 건네주기 / 살펴보기 요청 / 확인 표시
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && onlyChanges(['owner', 'ownerName', 'fromName', 'seen', 'inspectReq']);
      // 주인: 조합 재료로 사용
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      // 조합 결과물: 존재하는 조합법의 결과일 때만 생성 가능
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.via is string
        && exists(/databases/$(database)/documents/recipes/$(request.resource.data.via))
        && get(/databases/$(database)/documents/recipes/$(request.resource.data.via)).data.result == request.resource.data.defId
        && request.resource.data.revealed == false;
    }

    // 푸시 알림 구독 정보 (기기별) — 푸시 서버는 관리자 키로 읽어요
    match /pushSubs/{uid} {
      allow read, write: if isMe(uid);
    }

    // 채팅
    match /channels/{ch} {
      allow get: if canChan(ch);
      allow list, write: if isAdmin();
      match /msgs/{m} {
        allow read: if canChan(ch);
        allow create: if canChan(ch) && notLocked(ch)
          && request.resource.data.uid == request.auth.uid
          && (isAdmin() || (request.resource.data.kind in ['ic', 'ooc']
                            && request.resource.data.code in [myHo(), '']));
        allow update: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid
              && onlyChanges(['text', 'img', 'edited', 'deleted']));
        allow delete: if isAdmin();
      }
    }
    // HO별 참여 중인 비밀 채널 목록 (KP가 관리)
    match /chatIndex/{ho} {
      allow read: if isAdmin() || (signedIn() && myHo() == ho);
      allow write: if isAdmin();
    }
    // 채팅 푸시 요청 (언급·귓속말) — 푸시 서버가 읽고 지워요
    match /pings/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
    }

    // 공용 메모
    match /notes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && (request.resource.data.kp == false || isAdmin());
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
