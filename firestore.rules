rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // KP admin emails live in the Firestore doc config/admins  (field: emails = array of lowercase emails)
    // You never need to edit this file. Edit that doc in the Firebase console instead.

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function myHo() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ho;
    }
    function canChan(ch) {
      return signedIn() && (ch == 'rp' || ch == 'ooc' || isAdmin()
        || (ch.matches('dm_.+') && request.auth.uid in ch.split('_'))
        || (exists(/databases/$(database)/documents/channels/$(ch)) && get(/databases/$(database)/documents/channels/$(ch)).data.type == 'secret'
            && myHo() in get(/databases/$(database)/documents/channels/$(ch)).data.members));
    }
    function notLocked(ch) {
      return isAdmin() || !exists(/databases/$(database)/documents/channels/$(ch)) || get(/databases/$(database)/documents/channels/$(ch)).data.get('locked', false) != true;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }

    match /progress/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) || isAdmin();
    }

    match /sched/{id} {
      allow read, write: if isAdmin();
    }

    match /public/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /maps/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /mapchunks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /assets/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && onlyChanges(['status']))
        || (signedIn() && resource.data.uid == request.auth.uid      // 대기 중 예약 고치기
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && onlyChanges(['day', 'slots', 'place', 'parts', 'note', 'editedAt']))
        || (signedIn() && resource.data.uid == request.auth.uid      // 승인된 예약 취소 요청 / 철회
            && resource.data.status == 'approved'
            && request.resource.data.status == 'approved'
            && onlyChanges(['cancelReq', 'cancelNote', 'cancelAt']))
        || (signedIn() && resource.data.status == 'pending'                 // 같이 가자는 신청에 답하기
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ho in resource.data.parts
            && onlyChanges(['resp']));
      allow delete: if isAdmin();
    }

    match /queue/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /calls/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
      allow update: if isMe(uid) && onlyChanges(['ack', 'reply', 'ackAt']);
    }

    match /itemDefs/{id} {
      allow read, write: if isAdmin();
    }
    match /recipes/{id} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    match /items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && onlyChanges(['owner', 'ownerName', 'fromName', 'seen', 'inspectReq']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.via is string
        && exists(/databases/$(database)/documents/recipes/$(request.resource.data.via))
        && get(/databases/$(database)/documents/recipes/$(request.resource.data.via)).data.result == request.resource.data.defId
        && request.resource.data.revealed == false;
    }

    match /pushSubs/{uid} {
      allow read, write: if isMe(uid);
      allow delete: if isAdmin();
    }

    match /channels/{ch} {
      allow get: if canChan(ch);
      allow list, write: if isAdmin();
      match /msgs/{m} {
        allow read: if canChan(ch);
        allow create: if canChan(ch) && notLocked(ch)
          && request.resource.data.uid == request.auth.uid
          && (isAdmin() || (request.resource.data.kind in ['ic', 'ooc']
                            && request.resource.data.code in [myHo(), '']));
        allow update: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid
              && onlyChanges(['text', 'img', 'edited', 'deleted']));
        allow delete: if isAdmin();
      }
    }
    match /chatIndex/{ho} {
      allow read: if isAdmin() || (signedIn() && myHo() == ho);
      allow write: if isAdmin();
    }
    match /pings/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
    }

    match /rooms/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.host == request.auth.uid);
    }

    match /roomSecrets/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if signedIn() && (request.resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/rooms/$(request.resource.data.room)).data.host == request.auth.uid);
    }

    match /draws/{id} {
      allow read, write: if signedIn();
    }

    match /teleBooks/{id} {
      allow read, write: if signedIn();
    }

    match /games/{id} {
      allow read, write: if signedIn();
    }

    match /wwActs/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/rooms/$(resource.data.room)).data.host == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room));
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /eggs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /notes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && (request.resource.data.kp == false || isAdmin());
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // 세션 일정 · 참석 응답
    match /sessions/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && onlyChanges(['rsvp']));
    }

    // 일정 조율 (체크 = 안 되는 날)
    match /availMonths/{ym} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /availRows/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && request.resource.data.code == myHo()
        && id == request.resource.data.ym + '_' + request.resource.data.code);
      allow delete: if isAdmin();
    }

    // 선물함 (받는 사람만 읽기)
    match /giftbox/{owner}/in/{id} {
      allow read: if isMe(owner) || isAdmin();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.got == false;
      allow update: if isMe(owner) && onlyChanges(['got']);
      allow delete: if isMe(owner) || isAdmin();
    }

    // 저택 소식지 (기고 → KP 승인 → 게재)
    match /newsReq/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
    match /news/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && onlyChanges(['reacts', 'cmts', 'reads']));
    }

    // 캐릭터 일기 (가린 부분은 diarySec 에 따로, 허락받은 사람만)
    match /diaries/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
    }
    match /diarySec/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.who));
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // 직접 만든 가구 (KP 가구 · PL 전용 가구)
    match /furn/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.kind == 'pl');
      allow update: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid && resource.data.kind == 'pl'
        && request.resource.data.by == request.auth.uid && request.resource.data.kind == 'pl');
      allow delete: if isAdmin();
    }

    // 기본 가구 그림 덮어쓰기 (KP)
    match /furnOv/{k} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 토큰: 직접 만든 옷 · 방 안 위치
    match /wear/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.kind == 'pl');
      allow update: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid && resource.data.kind == 'pl' && request.resource.data.by == request.auth.uid && request.resource.data.kind == 'pl');
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }
    match /avOv/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /avpos/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
      allow delete: if isAdmin();
    }

    // 경매 (PL 가구 복제품)
    match /auctions/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.seller == request.auth.uid && request.resource.data.bid == null;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid != resource.data.seller && onlyChanges(['bid', 'n', 'endAt'])
            && request.resource.data.bid.uid == request.auth.uid
            && request.time.toMillis() < resource.data.endAt
            && request.resource.data.endAt <= resource.data.endAt
            && (resource.data.bid == null || request.resource.data.bid.amt > resource.data.bid.amt))
        || (signedIn() && resource.data.bid != null && request.auth.uid == resource.data.bid.uid && onlyChanges(['got']))
        || (isMe(resource.data.seller) && onlyChanges(['paid']));
      allow delete: if isAdmin() || (isMe(resource.data.seller) && resource.data.bid == null);
    }

    match /thefts/{owner}/log/{id} {
      allow read: if isMe(owner) || isAdmin();
      allow create: if signedIn() && owner != request.auth.uid
        && request.resource.data.thief == request.auth.uid
        && request.resource.data.owner == owner
        && request.resource.data.amt is int && request.resource.data.amt >= 0 && request.resource.data.amt <= 12
        && request.resource.data.done == false
        && id.matches('.*_' + request.auth.uid);
      allow update: if isAdmin() || (isMe(owner) && onlyChanges(['done']));
      allow delete: if isAdmin();
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 방 커튼 (창문 · 천개 침대): 방문자도 치고 걷을 수 있음
    match /curt/{owner} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['c', 'by', 'at']) && request.resource.data.c is map && request.resource.data.c.size() <= 60;
      allow delete: if isAdmin();
    }
    match /roomLikes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.owner + '_' + request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /guestbook/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow delete: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || resource.data.owner == request.auth.uid));
    }
  }
}
